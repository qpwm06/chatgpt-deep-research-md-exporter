{
  "manifest_version": 3,
  "name": "ChatGPT Deep Research Markdown Exporter",
  "version": "0.3.0",
  "description": "Export Deep Research reports directly from ChatGPT conversations to Markdown with source URLs.",
  "permissions": [
    "activeTab",
    "tabs",
    "downloads",
    "storage",
    "webNavigation",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.web-sandbox.oaiusercontent.com/*"
  ],
  "action": {
    "default_title": "Deep Research Markdown Exporter",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://*.web-sandbox.oaiusercontent.com/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-bridge.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://*.web-sandbox.oaiusercontent.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgpt-deep-research-md-exporter@qpwm06",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
